{
  "name": "ungite",
  "type": "module",
  "version": "0.0.5",
  "packageManager": "pnpm@12.16.1",
  "description": "Easily to control git.",
  "author": "Chris <https://github.com/zyyv>",
  "license": "MIT",
  "homepage": "https://github.com/zyyv/ungite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyyv/ungite.git"
  },
  "bugs": {
    "url": "https://github.com/zyyv/ungite/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "bin": {
    "ungite": "./bin/ungite.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp --commit --push --tag && pnpm publish",
    "start": "esno src/index.ts",
    "lint": "eslint .",
    "test": "vitest",
    "test:update": "vitest -u",
    "typecheck": "tcs --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cac": "^7.1.0",
    "consola": "^3.4.2",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@babel/types": "^8.0.10",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "esno": "^4.8.0",
    "typescript": "^6.0.2",
    "unbuild": "^3.6.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
